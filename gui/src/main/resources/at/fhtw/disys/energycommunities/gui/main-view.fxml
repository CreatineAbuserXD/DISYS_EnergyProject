<?xml version="1.0" encoding="UTF-8"?>

<!-- =========================================
     ENERGY COMMUNITIES - GUI
     =========================================
     [ ] Current data: communityDepleted + gridPortion Labels
     [ ] Refresh Button -> GET /energy/current
     [ ] Date range pickers (start / end)
     [ ] Load Button -> GET /energy/historical
     [ ] TableView: bucketHour, produced, used, grid
     ========================================= -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<VBox alignment="TOP_LEFT" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="at.fhtw.disys.energycommunities.gui.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Header -->
    <Label text="Energy Communities" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
    <Label text="A project by Jakob, Philip and Matthias" style="-fx-font-size: 12; -fx-text-fill: grey;"/>

    <Separator/>

    <!-- Current Energy -->
    <Label text="Current Energy" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
    <Button text="See Current Energy" onAction="#onSeeCurrentEnergy"/>

    <!-- Label für community depleted -->
    <Label fx:id="communityDepletedLabel" text="Community Depleted: -"/>

    <!-- Label für grid portion -->
    <Label fx:id="gridPortionLabel" text="Grid Portion: -"/>

</VBox>
